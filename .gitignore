# -----------------------------------------------------------------------------
.cache/
**/.cache/
.temp/
.tmp/
**/.temp/
**/.tmp/
*.tmp
*.temp
.eslintcache
.stylelintcache
.parcel-cache/
**/.parcel-cache/
.turbo/
.swc/
**/.swc/

